+    /// SEI PATCH (not upstream): the files `extract_lib_contents_to_path` writes, as (path relative to the target
+    /// folder with '/' separators, size in bytes). Symlinks are listed with size `u64::MAX` (not size-checked).
+    /// Used to check a staged copy of the app before it replaces `current`, and to size the disk-space check.
+    #[cfg(not(target_os = "linux"))]
+    pub fn get_lib_contents_sizes(&self) -> Result<Vec<(String, u64)>, Error> {
+        let re = Regex::new(r"lib[\\\/][^\\\/]*[\\\/]").unwrap();
+        let stub_regex = Regex::new("_ExecutionStub.exe$").unwrap();
+        let symlink_regex = Regex::new(".__symlink$").unwrap();
+        let updater_idx = self.find_zip_file(|name| name.ends_with("Squirrel.exe"));
+        let nuspec_idx = self.find_zip_file(|name| name.ends_with(".nuspec"));
+        let mut out = Vec::new();
+        let mut archive = self.zip.borrow_mut();
+        // extract_lib_contents_to_path writes the nuspec as sq.version FIRST, so a lib entry of the same name
+        // (newer packages carry one) overwrites it: callers must let later entries win.
+        #[cfg(target_os = "windows")]
+        if let Some(n) = nuspec_idx {
+            out.push(("sq.version".to_string(), archive.by_index(n)?.size()));
+        }
+        for i in 0..archive.len() {
+            let file = archive.by_index(i)?;
+            let key = file.name()?.into_owned();
+            let size = file.size();
+            if Some(i) == updater_idx || !re.is_match(&key) || key.ends_with('/') || key.ends_with('\\') {
+                continue;
+            }
+            let rel = re.replace(&key, "").to_string();
+            if symlink_regex.is_match(&rel) {
+                out.push((symlink_regex.replace(&rel, "").to_string(), u64::MAX));
+                continue;
+            }
+            if stub_regex.is_match(&rel) {
+                continue;
+            }
+            out.push((rel.replace('\\', "/"), size));
+        }
+        #[cfg(not(target_os = "windows"))]
+        let _ = nuspec_idx;
+        Ok(out)
+    }
+
     #[cfg(not(target_os = "linux"))]
     pub fn extract_lib_contents_to_path<P: AsRef<Path>, F: Fn(i16)>(&self, current_path: P, progress: F) -> Result<(), Error> {
         let current_path = current_path.as_ref();
