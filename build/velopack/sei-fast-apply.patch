+++ b/src/bins/src/windows/sei_overlay.rs
@@ -0,0 +1,529 @@
+//! SEI PATCH (not upstream Velopack): the "Updating" overlay shown while Update.exe applies an update.
+//!
+//! Sei renders every frame itself (its own launch splash plus a short status line, as PNGs at physical pixel size)
+//! into a folder and passes it as `apply --seiOverlay <dir>`. This module only shows them: a borderless,
+//! click-through, topmost layered window at the position Sei asked for. It is shown before Update.exe waits for Sei
+//! to exit, so it sits on top of Sei's identical in-app splash and the hand-off is invisible, and it closes once the
+//! restarted Sei has a visible window of its own.
+//!
+//! `<dir>/overlay.txt` is `key=value` lines:
+//!   x, y          top-left corner in physical pixels
+//!   slowAfterMs   when to start showing a time estimate instead of the plain frame
+//!   frame.<name>  a PNG in <dir>. Names: `updating` (required), `error`, `eta-<seconds>` buckets, `eta-long`.
+//! Once the window is on screen this module writes `<dir>/shown`, which Sei waits for before it quits.
+
+use anyhow::{anyhow, bail, Result};
+use image::ImageReader;
+use std::{
+    cell::RefCell,
+    collections::HashMap,
+    fs,
+    io::Cursor,
+    path::{Path, PathBuf},
+    sync::{
+        atomic::{AtomicBool, AtomicI32, AtomicU64, AtomicU8, Ordering},
+        mpsc, Mutex,
+    },
+    thread,
+    time::{Duration, Instant},
+};
+use velopack::wide_strings::string_to_wide;
+use windows::{
+    core::BOOL,
+    Win32::{
+        Foundation::{COLORREF, HINSTANCE, HWND, LPARAM, LRESULT, POINT, RECT, SIZE, WPARAM},
+        Graphics::Gdi::*,
+        System::LibraryLoader::GetModuleHandleW,
+        UI::WindowsAndMessaging::*,
+    },
+};
+
+/// Where the apply is. Drives which frame shows once the update is slower than expected.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+#[repr(u8)]
+pub enum Phase {
+    /// Waiting for Sei to exit, loading the package, checking prerequisites.
+    Waiting = 0,
+    /// No staged copy: extracting the full package (progress via `set_progress`).
+    Extracting = 1,
+    /// Renaming folders (may retry while something holds a file open).
+    Swapping = 2,
+    /// The new (or, after a failure, the old) Sei has been started.
+    Started = 3,
+    /// The update failed; the old version is about to be started.
+    Failed = 4,
+}
+
+static PHASE: AtomicU8 = AtomicU8::new(0);
+static PROGRESS: AtomicI32 = AtomicI32::new(-1);
+static EXTRACT_START_MS: AtomicU64 = AtomicU64::new(0);
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+
+lazy_static! {
+    static ref STARTED_AT: Mutex<Option<Instant>> = Mutex::new(None);
+    static ref CLOSE_TX: Mutex<Option<mpsc::Sender<()>>> = Mutex::new(None);
+    static ref THREADS: Mutex<Vec<thread::JoinHandle<()>>> = Mutex::new(Vec::new());
+}
+
+fn now_ms() -> u64 {
+    STARTED_AT.lock().ok().and_then(|g| g.map(|t| t.elapsed().as_millis() as u64)).unwrap_or(0)
+}
+
+pub fn set_phase(phase: Phase) {
+    if phase == Phase::Extracting && PHASE.load(Ordering::SeqCst) != Phase::Extracting as u8 {
+        EXTRACT_START_MS.store(now_ms(), Ordering::SeqCst);
+        PROGRESS.store(0, Ordering::SeqCst);
+    }
+    PHASE.store(phase as u8, Ordering::SeqCst);
+}
+
+pub fn set_progress(progress: i16) {
+    PROGRESS.store(progress as i32, Ordering::SeqCst);
+}
+
+/// True while the overlay window is up.
+pub fn is_active() -> bool {
+    ACTIVE.load(Ordering::SeqCst)
+}
+
+struct Spec {
+    x: i32,
+    y: i32,
+    slow_after: Duration,
+    files: HashMap<String, PathBuf>,
+}
+
+fn read_spec(dir: &Path) -> Result<Spec> {
+    let text = fs::read_to_string(dir.join("overlay.txt"))?;
+    let mut x = None;
+    let mut y = None;
+    let mut slow_after = Duration::from_millis(8000);
+    let mut files = HashMap::new();
+    for line in text.lines() {
+        let line = line.trim();
+        let Some((k, v)) = line.split_once('=') else { continue };
+        let (k, v) = (k.trim(), v.trim());
+        match k {
+            "x" => x = v.parse::<i32>().ok(),
+            "y" => y = v.parse::<i32>().ok(),
+            "slowAfterMs" => {
+                if let Ok(ms) = v.parse::<u64>() {
+                    slow_after = Duration::from_millis(ms);
+                }
+            }
+            _ => {
+                if let Some(name) = k.strip_prefix("frame.") {
+                    // only plain file names inside <dir>
+                    if !v.is_empty() && !v.contains(['/', '\\', ':']) && !v.contains("..") {
+                        files.insert(name.to_string(), dir.join(v));
+                    }
+                }
+            }
+        }
+    }
+    if !files.contains_key("updating") {
+        bail!("overlay.txt has no frame.updating");
+    }
+    Ok(Spec {
+        x: x.ok_or_else(|| anyhow!("overlay.txt has no x"))?,
+        y: y.ok_or_else(|| anyhow!("overlay.txt has no y"))?,
+        slow_after,
+        files,
+    })
+}
+
+/// RGBA (straight) to BGRA premultiplied, as UpdateLayeredWindow with AC_SRC_ALPHA expects.
+fn to_premultiplied_bgra(pixels: &mut [u8]) {
+    for px in pixels.chunks_exact_mut(4) {
+        let (r, g, b, a) = (px[0] as u32, px[1] as u32, px[2] as u32, px[3] as u32);
+        px[0] = ((b * a + 127) / 255) as u8;
+        px[1] = ((g * a + 127) / 255) as u8;
+        px[2] = ((r * a + 127) / 255) as u8;
+        px[3] = a as u8;
+    }
+}
+
+struct Frame {
+    name: String,
+    w: i32,
+    h: i32,
+    bgra: Vec<u8>,
+}
+
+fn load_frames(spec: &Spec) -> Result<Vec<Frame>> {
+    let mut frames = Vec::new();
+    // `updating` first: index 0 is the frame shown at start.
+    let mut names: Vec<&String> = spec.files.keys().collect();
+    names.sort_by_key(|n| if n.as_str() == "updating" { 0 } else { 1 });
+    for name in names {
+        let path = &spec.files[name];
+        let bytes = match fs::read(path) {
+            Ok(b) => b,
+            Err(e) => {
+                warn!("Overlay frame {:?} unreadable: {}", path, e);
+                continue;
+            }
+        };
+        let img = match ImageReader::new(Cursor::new(bytes)).with_guessed_format().map_err(|e| anyhow!(e)).and_then(|r| r.decode().map_err(|e| anyhow!(e))) {
+            Ok(i) => i.into_rgba8(),
+            Err(e) => {
+                warn!("Overlay frame {:?} undecodable: {}", path, e);
+                continue;
+            }
+        };
+        let (w, h) = (img.width() as i32, img.height() as i32);
+        let mut bgra = img.into_vec();
+        to_premultiplied_bgra(&mut bgra);
+        frames.push(Frame { name: name.clone(), w, h, bgra });
+    }
+    if frames.first().map(|f| f.name.as_str()) != Some("updating") {
+        bail!("overlay frame 'updating' could not be loaded");
+    }
+    Ok(frames)
+}
+
+/// Chooses the frame for the current moment. `shown` is the frame index on screen.
+struct Picker {
+    slow_after: Duration,
+    updating: usize,
+    error: Option<usize>,
+    /// (bucket seconds, frame index), ascending.
+    etas: Vec<(u64, usize)>,
+    long: Option<usize>,
+    last_change: Option<Instant>,
+}
+
+impl Picker {
+    fn new(frames: &[Frame], slow_after: Duration) -> Self {
+        let mut etas = Vec::new();
+        let mut long = None;
+        let mut error = None;
+        for (i, f) in frames.iter().enumerate() {
+            if f.name == "error" {
+                error = Some(i);
+            } else if f.name == "eta-long" {
+                long = Some(i);
+            } else if let Some(s) = f.name.strip_prefix("eta-").and_then(|s| s.parse::<u64>().ok()) {
+                etas.push((s, i));
+            }
+        }
+        etas.sort();
+        Picker { slow_after, updating: 0, error, etas, long, last_change: None }
+    }
+
+    fn estimate_secs(&self, elapsed_ms: u64) -> u64 {
+        let phase = PHASE.load(Ordering::SeqCst);
+        if phase == Phase::Extracting as u8 {
+            let p = PROGRESS.load(Ordering::SeqCst).clamp(0, 100) as u64;
+            let since = elapsed_ms.saturating_sub(EXTRACT_START_MS.load(Ordering::SeqCst));
+            if p >= 3 {
+                // remaining extraction plus a few seconds for the swap and the start
+                return since * (100 - p) / p / 1000 + 4;
+            }
+            return 30;
+        }
+        // waiting for Sei to exit or retrying a locked rename: usually seconds
+        10
+    }
+
+    fn pick(&mut self, shown: usize) -> usize {
+        let phase = PHASE.load(Ordering::SeqCst);
+        if phase == Phase::Failed as u8 {
+            return self.error.unwrap_or(self.updating);
+        }
+        let elapsed_ms = now_ms();
+        if phase == Phase::Started as u8 || Duration::from_millis(elapsed_ms) < self.slow_after || (self.etas.is_empty() && self.long.is_none()) {
+            return if shown == self.updating || phase != Phase::Started as u8 { self.updating } else { shown };
+        }
+        let eta = self.estimate_secs(elapsed_ms);
+        let want = self.etas.iter().find(|(s, _)| *s >= eta).map(|(_, i)| *i).or(self.long).unwrap_or(self.updating);
+        if want == shown {
+            return shown;
+        }
+        // hysteresis: an estimate changes at most every 2 s, so it never flickers between two buckets
+        if let Some(t) = self.last_change {
+            if t.elapsed() < Duration::from_secs(2) {
+                return shown;
+            }
+        }
+        self.last_change = Some(Instant::now());
+        want
+    }
+}
+
+struct Win {
+    hwnd: HWND,
+    x: i32,
+    y: i32,
+    hdc_mem: HDC,
+    bitmaps: Vec<(HBITMAP, i32, i32)>,
+    shown: usize,
+    picker: Picker,
+    close_rx: mpsc::Receiver<()>,
+}
+
+thread_local! {
+    static WIN: RefCell<Option<Win>> = const { RefCell::new(None) };
+}
+
+const BLEND: BLENDFUNCTION = BLENDFUNCTION {
+    BlendOp: AC_SRC_OVER as u8,
+    BlendFlags: 0,
+    SourceConstantAlpha: 255,
+    AlphaFormat: AC_SRC_ALPHA as u8,
+};
+const TMR_TICK: usize = 7;
+
+impl Win {
+    unsafe fn present(&mut self, idx: usize) {
+        let Some(&(bmp, w, h)) = self.bitmaps.get(idx) else { return };
+        let old = SelectObject(self.hdc_mem, bmp.into());
+        let size = SIZE { cx: w, cy: h };
+        let pt_src = POINT { x: 0, y: 0 };
+        let pt_dst = POINT { x: self.x, y: self.y };
+        let _ = UpdateLayeredWindow(
+            self.hwnd,
+            None,
+            Some(&pt_dst),
+            Some(&size),
+            Some(self.hdc_mem),
+            Some(&pt_src),
+            COLORREF(0),
+            Some(&BLEND),
+            ULW_ALPHA,
+        );
+        let _ = SelectObject(self.hdc_mem, old);
+        if idx != self.shown {
+            info!("Overlay frame -> {}", idx);
+        }
+        self.shown = idx;
+    }
+
+    unsafe fn tick(&mut self) {
+        if self.close_rx.try_recv().is_ok() {
+            let _ = PostMessageW(Some(self.hwnd), WM_CLOSE, WPARAM(0), LPARAM(0));
+            return;
+        }
+        let next = self.picker.pick(self.shown);
+        if next != self.shown {
+            self.present(next);
+        }
+    }
+}
+
+unsafe extern "system" fn wnd_proc(hwnd: HWND, msg: u32, wparam: WPARAM, lparam: LPARAM) -> LRESULT {
+    match msg {
+        WM_TIMER => {
+            WIN.with(|w| {
+                if let Ok(mut w) = w.try_borrow_mut() {
+                    if let Some(w) = w.as_mut() {
+                        w.tick();
+                    }
+                }
+            });
+            LRESULT(0)
+        }
+        WM_DESTROY => {
+            PostQuitMessage(0);
+            LRESULT(0)
+        }
+        _ => DefWindowProcW(hwnd, msg, wparam, lparam),
+    }
+}
+
+unsafe fn run_window(spec: Spec, frames: Vec<Frame>, dir: PathBuf, close_rx: mpsc::Receiver<()>, ready_tx: mpsc::Sender<bool>) -> Result<()> {
+    let class_name = string_to_wide("SeiUpdateOverlay");
+    let title = string_to_wide("Sei");
+    let h_instance: HINSTANCE = GetModuleHandleW(None)?.into();
+    let wc = WNDCLASSEXW {
+        cbSize: std::mem::size_of::<WNDCLASSEXW>() as u32,
+        lpfnWndProc: Some(wnd_proc),
+        hInstance: h_instance,
+        hCursor: LoadCursorW(None, IDC_ARROW)?,
+        lpszClassName: class_name.as_pcwstr(),
+        ..Default::default()
+    };
+    if RegisterClassExW(&wc) == 0 {
+        let err = std::io::Error::last_os_error();
+        if err.raw_os_error() != Some(1410) {
+            bail!("RegisterClassExW failed: {:?}", err);
+        }
+    }
+    let (w0, h0) = (frames[0].w, frames[0].h);
+    let hwnd = CreateWindowExW(
+        WS_EX_LAYERED | WS_EX_TOPMOST | WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE | WS_EX_TRANSPARENT,
+        class_name.as_pcwstr(),
+        title.as_pcwstr(),
+        WS_POPUP,
+        spec.x,
+        spec.y,
+        w0,
+        h0,
+        None,
+        None,
+        Some(h_instance),
+        None,
+    )?;
+
+    let hdc_screen = GetDC(None);
+    let hdc_mem = CreateCompatibleDC(Some(hdc_screen));
+    let _ = ReleaseDC(None, hdc_screen);
+    let bitmaps: Vec<(HBITMAP, i32, i32)> =
+        frames.iter().map(|f| (CreateBitmap(f.w, f.h, 1, 32, Some(f.bgra.as_ptr() as *const _)), f.w, f.h)).collect();
+    let picker = Picker::new(&frames, spec.slow_after);
+    drop(frames);
+
+    let mut win = Win { hwnd, x: spec.x, y: spec.y, hdc_mem, bitmaps, shown: usize::MAX, picker, close_rx };
+    win.present(0);
+    let _ = ShowWindow(hwnd, SW_SHOWNOACTIVATE);
+    WIN.with(|w| *w.borrow_mut() = Some(win));
+    let _ = SetTimer(Some(hwnd), TMR_TICK, 100, None);
+    ACTIVE.store(true, Ordering::SeqCst);
+    let _ = fs::write(dir.join("shown"), b"1");
+    info!("Overlay shown at {},{} ({}x{})", spec.x, spec.y, w0, h0);
+    let _ = ready_tx.send(true);
+
+    let mut msg = MSG::default();
+    while GetMessageW(&mut msg, None, 0, 0).as_bool() {
+        let _ = TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+    }
+
+    ACTIVE.store(false, Ordering::SeqCst);
+    WIN.with(|w| {
+        if let Some(win) = w.borrow_mut().take() {
+            for (bmp, _, _) in win.bitmaps {
+                let _ = DeleteObject(bmp.into());
+            }
+            let _ = DeleteDC(win.hdc_mem);
+        }
+    });
+    info!("Overlay closed");
+    Ok(())
+}
+
+/// Shows the overlay described by `<dir>/overlay.txt`. Returns once it is on screen (or failed), so the caller can
+/// rely on it covering the gap from here on. Never fails the update: any problem just means no overlay.
+pub fn start(dir: &Path) -> bool {
+    let spec = match read_spec(dir) {
+        Ok(s) => s,
+        Err(e) => {
+            warn!("No update overlay ({}): {:?}", dir.display(), e);
+            return false;
+        }
+    };
+    let frames = match load_frames(&spec) {
+        Ok(f) => f,
+        Err(e) => {
+            warn!("No update overlay, frames failed to load: {:?}", e);
+            return false;
+        }
+    };
+    if let Ok(mut g) = STARTED_AT.lock() {
+        *g = Some(Instant::now());
+    }
+    let (close_tx, close_rx) = mpsc::channel::<()>();
+    let (ready_tx, ready_rx) = mpsc::channel::<bool>();
+    if let Ok(mut g) = CLOSE_TX.lock() {
+        *g = Some(close_tx);
+    }
+    let dir = dir.to_path_buf();
+    let fail_tx = ready_tx.clone();
+    let handle = thread::spawn(move || {
+        if let Err(e) = unsafe { run_window(spec, frames, dir, close_rx, ready_tx) } {
+            error!("Update overlay failed: {:?}", e);
+            let _ = fail_tx.send(false);
+        }
+    });
+    if let Ok(mut t) = THREADS.lock() {
+        t.push(handle);
+    }
+    ready_rx.recv_timeout(Duration::from_secs(3)).unwrap_or(false)
+}
+
+pub fn close_now() {
+    if let Ok(g) = CLOSE_TX.lock() {
+        if let Some(tx) = g.as_ref() {
+            let _ = tx.send(());
+        }
+    }
+}
+
+struct FindCtx {
+    pid: u32,
+    found: bool,
+}
+
+unsafe extern "system" fn enum_cb(hwnd: HWND, lparam: LPARAM) -> BOOL {
+    let ctx = &mut *(lparam.0 as *mut FindCtx);
+    let mut pid: u32 = 0;
+    let _ = GetWindowThreadProcessId(hwnd, Some(&mut pid));
+    if pid == ctx.pid && IsWindowVisible(hwnd).as_bool() {
+        let mut rc = RECT::default();
+        if GetWindowRect(hwnd, &mut rc).is_ok() && rc.right - rc.left > 1 && rc.bottom - rc.top > 1 {
+            ctx.found = true;
+            return BOOL(0);
+        }
+    }
+    BOOL(1)
+}
+
+/// True when the process has a visible, non-empty top-level window.
+pub fn has_visible_window(pid: u32) -> bool {
+    let mut ctx = FindCtx { pid, found: false };
+    unsafe {
+        let _ = EnumWindows(Some(enum_cb), LPARAM(&mut ctx as *mut FindCtx as isize));
+    }
+    ctx.found
+}
+
+/// Closes the overlay once `pid` shows a window (Sei's own splash, which looks the same), or after `timeout`.
+/// Runs on its own thread so the slow cleanup after a swap never keeps the overlay over the restarted app.
+pub fn close_when_window_visible(pid: u32, timeout: Duration) {
+    if !is_active() {
+        return;
+    }
+    let handle = thread::spawn(move || {
+        let sw = Instant::now();
+        while sw.elapsed() < timeout {
+            if has_visible_window(pid) {
+                info!("Restarted app (pid {}) shows a window after {}ms, closing the overlay", pid, sw.elapsed().as_millis());
+                // let the compositor put the new window on screen before the overlay goes
+                thread::sleep(Duration::from_millis(150));
+                close_now();
+                return;
+            }
+            thread::sleep(Duration::from_millis(50));
+        }
+        warn!("Restarted app (pid {}) showed no window within {}s, closing the overlay", pid, timeout.as_secs());
+        close_now();
+    });
+    if let Ok(mut t) = THREADS.lock() {
+        t.push(handle);
+    }
+}
+
+/// Shows the error frame for `hold`, then returns (the caller starts the old version next).
+pub fn show_error(hold: Duration) {
+    set_phase(Phase::Failed);
+    if is_active() {
+        thread::sleep(hold);
+    }
+}
+
+/// Waits (bounded) for the overlay and its closer to finish before the process exits: exiting early would drop the
+/// overlay before the restarted app is on screen.
+pub fn join(timeout: Duration) {
+    let sw = Instant::now();
+    loop {
+        let pending = THREADS.lock().map(|t| t.iter().any(|h| !h.is_finished())).unwrap_or(false);
+        if !pending || sw.elapsed() > timeout {
+            break;
+        }
+        thread::sleep(Duration::from_millis(50));
+    }
+    if is_active() {
+        close_now();
+        thread::sleep(Duration::from_millis(200));
+    }
+}
