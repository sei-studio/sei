index 00000000..3e9307d6
--- /dev/null
+++ b/src/bins/src/commands/sei_fast.rs
@@ -0,0 +1,407 @@
+//! SEI PATCH (not upstream Velopack): fast apply.
+//!
+//! Stock `apply` extracts the whole package (744 MB / 6,400 files for Sei) AFTER the app has exited, which is the
+//! ~20 s blank gap of an in-app restart. This module moves that work to while the app is still running:
+//!
+//!   `Update.exe stage --package <nupkg>` (started by Sei right after a download, at below-normal CPU priority) extracts
+//!   the package to `<packages>\SeiStaged\v<version>.partial`, renames it to `v<version>` when complete and writes
+//!   `v<version>.ok` with the package's name and size. A kill at any point leaves no `.ok`, so the copy is ignored
+//!   and cleaned up by the next stage.
+//!
+//!   `apply` then calls `take_staged`: when the `.ok` marker matches the package being applied and every file is
+//!   present with the right size, the staged folder is renamed into `current` instead of extracting. Anything
+//!   else falls back to the stock extraction, so a missing or broken staged copy only costs time.
+//!
+//! With `--noHooks` (Sei handles no Velopack hooks) the restarted app is also started right after the swap, before
+//! the uninstall-entry, shortcut and old-folder cleanup, which then runs at background priority.
+//!
+//! Also here: the `applying.pid` marker (Sei, launched during an apply, sees it and leaves instead of blocking the
+//! swap) and the `relaunch` request it leaves behind, which a no-restart apply honours when it is done.
+
+use crate::windows::sei_overlay::{self, Phase};
+use anyhow::{anyhow, bail, Result};
+use std::{
+    collections::HashMap,
+    ffi::OsString,
+    fs,
+    path::{Path, PathBuf},
+    sync::Mutex,
+    time::{Duration, Instant},
+};
+use velopack::{bundle, bundle::BundleZip, constants, locator::VelopackLocator, lockfile::LockFile, process, wide_strings::string_to_wide};
+use ::windows::Win32::{
+    Foundation::FreeLibrary,
+    Storage::FileSystem::GetDiskFreeSpaceExW,
+    System::LibraryLoader::{LoadLibraryExW, LOAD_LIBRARY_AS_DATAFILE, LOAD_LIBRARY_AS_IMAGE_RESOURCE},
+    System::ProcessStatus::EnumProcesses,
+    System::Threading::{GetCurrentProcess, SetPriorityClass, BELOW_NORMAL_PRIORITY_CLASS, PROCESS_MODE_BACKGROUND_BEGIN},
+};
+
+pub const STAGE_DIR: &str = "SeiStaged";
+/// Free space left on the volume after staging. Below this, staging is skipped (stock apply still works).
+const DISK_MARGIN: u64 = 1024 * 1024 * 1024;
+
+lazy_static! {
+    /// Some(args): start the app right after the swap (set by apply when restarting without hooks).
+    static ref EARLY_START: Mutex<Option<Option<Vec<OsString>>>> = Mutex::new(None);
+    static ref STARTED_PID: Mutex<Option<u32>> = Mutex::new(None);
+}
+
+pub fn stage_root(locator: &VelopackLocator) -> PathBuf {
+    locator.get_packages_dir().join(STAGE_DIR)
+}
+
+fn final_dir(root: &Path, version: &str) -> PathBuf {
+    root.join(format!("v{}", version))
+}
+
+fn partial_dir(root: &Path, version: &str) -> PathBuf {
+    root.join(format!("v{}.partial", version))
+}
+
+fn marker_file(root: &Path, version: &str) -> PathBuf {
+    root.join(format!("v{}.ok", version))
+}
+
+fn package_identity(package: &Path) -> Result<String> {
+    let name = package.file_name().ok_or_else(|| anyhow!("package path has no file name"))?.to_string_lossy().to_string();
+    let size = fs::metadata(package)?.len();
+    Ok(format!("{}|{}", name, size))
+}
+
+/// Below-normal CPU priority with normal I/O, for the stage. Background mode (very low I/O priority) made a
+/// 744 MB extraction take 90-160 s on a CI runner against ~12 s at normal priority, long enough that a user who
+/// restarts soon after the download would usually miss the staged copy.
+pub fn set_stage_priority() {
+    unsafe {
+        if let Err(e) = SetPriorityClass(GetCurrentProcess(), BELOW_NORMAL_PRIORITY_CLASS) {
+            warn!("Could not lower the priority: {}", e);
+        }
+    }
+}
+
+/// Low CPU, I/O and memory priority for the rest of this process.
+pub fn set_background_priority() {
+    unsafe {
+        if let Err(e) = SetPriorityClass(GetCurrentProcess(), PROCESS_MODE_BACKGROUND_BEGIN) {
+            warn!("Could not enter background mode: {}", e);
+        }
+    }
+}
+
+fn free_bytes(path: &Path) -> Option<u64> {
+    let wide = string_to_wide(path);
+    let mut free: u64 = 0;
+    unsafe { GetDiskFreeSpaceExW(wide.as_pcwstr(), Some(&mut free), None, None) }.ok().map(|_| free)
+}
+
+fn write_result(root: &Path, line: &str) {
+    info!("Stage result: {}", line);
+    let _ = fs::write(root.join("last-result.txt"), line);
+}
+
+fn expected_files(bundle: &BundleZip) -> Result<HashMap<String, u64>> {
+    let mut map = HashMap::new();
+    for (rel, size) in bundle.get_lib_contents_sizes()? {
+        map.insert(rel, size); // later entries win, as they do on disk
+    }
+    Ok(map)
+}
+
+fn verify_tree(dir: &Path, expected: &HashMap<String, u64>) -> Result<()> {
+    for (rel, size) in expected {
+        let p = dir.join(rel.replace('/', "\\"));
+        let md = fs::symlink_metadata(&p).map_err(|e| anyhow!("{:?}: {}", p, e))?;
+        if *size != u64::MAX && md.len() != *size {
+            bail!("{:?} is {} bytes, expected {}", p, md.len(), size);
+        }
+    }
+    Ok(())
+}
+
+fn remove_any(p: &Path) {
+    let r = if p.is_dir() { remove_dir_all::remove_dir_all(p) } else { fs::remove_file(p) };
+    if let Err(e) = r {
+        warn!("Could not remove {:?}: {}", p, e);
+    }
+}
+
+/// Removes everything in the stage root except the lock, the last result and `keep` (and its marker).
+fn clean_root(root: &Path, keep_version: Option<&str>) {
+    let Ok(entries) = fs::read_dir(root) else { return };
+    let keep: Vec<String> = keep_version.map(|v| vec![format!("v{}", v), format!("v{}.ok", v)]).unwrap_or_default();
+    for entry in entries.flatten() {
+        let name = entry.file_name().to_string_lossy().to_string();
+        if name == ".lock" || name == "last-result.txt" || name == "applying.pid" || name == "relaunch" || keep.contains(&name) {
+            continue;
+        }
+        info!("Removing stale staged item {:?}", entry.path());
+        remove_any(&entry.path());
+    }
+}
+
+/// `Update.exe stage --package <nupkg>`.
+pub fn stage(locator: &VelopackLocator, package: &Path) -> Result<()> {
+    set_stage_priority();
+    let sw = Instant::now();
+    let root = stage_root(locator);
+    fs::create_dir_all(&root)?;
+    let _lock = LockFile::try_acquire_lock(root.join(".lock")).map_err(|e| anyhow!("another stage is running ({})", e))?;
+
+    let mut bundle = bundle::load_bundle_from_file(package)?;
+    let manifest = bundle.read_manifest()?;
+    let version = manifest.version.to_string();
+    if manifest.version <= locator.get_manifest_version() {
+        write_result(&root, &format!("skipped {}: not newer than the installed {}", version, locator.get_manifest_version()));
+        bail!("package {} is not newer than the installed version", version);
+    }
+    let identity = package_identity(package)?;
+    let expected = expected_files(&bundle)?;
+    let dir = final_dir(&root, &version);
+    let marker = marker_file(&root, &version);
+
+    if dir.is_dir() && fs::read_to_string(&marker).map(|m| m.trim() == identity).unwrap_or(false) && verify_tree(&dir, &expected).is_ok() {
+        clean_root(&root, Some(&version));
+        write_result(&root, &format!("ok {} already staged", version));
+        return Ok(());
+    }
+
+    clean_root(&root, None);
+
+    let needed: u64 = expected.values().filter(|s| **s != u64::MAX).sum();
+    if let Some(free) = free_bytes(&root) {
+        if free < needed + DISK_MARGIN {
+            write_result(
+                &root,
+                &format!("skipped {}: low disk, {} MB free, staging needs {} MB plus {} MB margin", version, free >> 20, needed >> 20, DISK_MARGIN >> 20),
+            );
+            bail!("not enough free disk space to stage");
+        }
+    }
+
+    let partial = partial_dir(&root, &version);
+    fs::create_dir_all(&partial)?;
+    info!("Staging {} ({} files, {} MB) into {:?}", version, expected.len(), needed >> 20, partial);
+    if let Err(e) = bundle.extract_lib_contents_to_path(&partial, |_| {}) {
+        write_result(&root, &format!("failed {}: extract: {}", version, e));
+        remove_any(&partial);
+        bail!("extract failed: {}", e);
+    }
+    let extracted_ms = sw.elapsed().as_millis();
+    if let Err(e) = verify_tree(&partial, &expected) {
+        write_result(&root, &format!("failed {}: verify: {}", version, e));
+        remove_any(&partial);
+        bail!("staged copy failed verification: {}", e);
+    }
+    fs::rename(&partial, &dir)?;
+    fs::write(&marker, &identity)?;
+    let prewarm_ms = prewarm_images(&dir);
+    write_result(
+        &root,
+        &format!("ok {} staged in {} ms (extract {} ms, prewarm {} ms)", version, sw.elapsed().as_millis(), extracted_ms, prewarm_ms),
+    );
+    Ok(())
+}
+
+/// Maps every top-level .exe and .dll of the staged copy as an image once and unmaps it. Creating an image section
+/// for a fresh file reads and checks the whole file (and is where on-execute antivirus scans happen); Windows keeps
+/// that section cached with the file, and a folder rename does not change the file, so the CreateProcess of the
+/// restarted app no longer pays for it inside the restart. Best effort: nothing here can fail the stage.
+fn prewarm_images(dir: &Path) -> u128 {
+    let sw = Instant::now();
+    let Ok(entries) = fs::read_dir(dir) else { return 0 };
+    let mut n = 0;
+    for entry in entries.flatten() {
+        let path = entry.path();
+        let ext = path.extension().and_then(|e| e.to_str()).map(|e| e.to_ascii_lowercase());
+        if !matches!(ext.as_deref(), Some("exe") | Some("dll")) {
+            continue;
+        }
+        let wide = string_to_wide(&path);
+        unsafe {
+            if let Ok(module) = LoadLibraryExW(wide.as_pcwstr(), None, LOAD_LIBRARY_AS_IMAGE_RESOURCE | LOAD_LIBRARY_AS_DATAFILE) {
+                let _ = FreeLibrary(module);
+                n += 1;
+            }
+        }
+    }
+    let ms = sw.elapsed().as_millis();
+    info!("Prewarmed {} images in {} ms", n, ms);
+    ms
+}
+
+fn pid_running(pid: u32) -> Option<bool> {
+    let mut pids = vec![0u32; 16384];
+    let mut needed = 0u32;
+    unsafe { EnumProcesses(pids.as_mut_ptr(), (pids.len() * 4) as u32, &mut needed).ok()? };
+    let n = (needed as usize / 4).min(pids.len());
+    Some(pids[..n].contains(&pid))
+}
+
+/// Waits until `pid` is no longer in the process list (no process handle needed). False on timeout.
+pub fn wait_pid_gone(pid: u32, timeout: Duration) -> bool {
+    let sw = Instant::now();
+    loop {
+        match pid_running(pid) {
+            Some(false) => {
+                info!("Process {} exited ({} ms after the wait started)", pid, sw.elapsed().as_millis());
+                return true;
+            }
+            None => {
+                warn!("Could not list processes; not waiting for {}", pid);
+                return false;
+            }
+            Some(true) => {}
+        }
+        if sw.elapsed() >= timeout {
+            warn!("Process {} still running after {} ms. Continuing...", pid, sw.elapsed().as_millis());
+            return false;
+        }
+        std::thread::sleep(Duration::from_millis(50));
+    }
+}
+
+/// `fs::rename` with retries, logging the first failure and the outcome instead of every attempt.
+pub fn retry_rename(from: &Path, to: &Path, delay_ms: i32, count: i32) -> std::io::Result<()> {
+    let sw = Instant::now();
+    // The destination's folder may not exist yet: with a staged copy nothing creates packages\VelopackTemp
+    // (upstream made it while extracting the package there), and a rename into a missing folder fails with
+    // os error 3 on every retry. Seen on a Full-only update (no delta was ever applied on that install).
+    if let Some(parent) = to.parent() {
+        let _ = fs::create_dir_all(parent);
+    }
+    let mut res = fs::rename(from, to);
+    if let Err(e) = &res {
+        warn!("Rename {:?} failed ({}), retrying every {} ms up to {} times", from, e, delay_ms, count);
+    } else {
+        return res;
+    }
+    for i in 0..count {
+        std::thread::sleep(Duration::from_millis(delay_ms.max(0) as u64));
+        res = fs::rename(from, to);
+        if res.is_ok() {
+            info!("Rename {:?} succeeded on retry {} after {} ms", from, i + 1, sw.elapsed().as_millis());
+            return res;
+        }
+    }
+    if let Err(e) = &res {
+        warn!("Rename {:?} still failing after {} ms: {}", from, sw.elapsed().as_millis(), e);
+    }
+    res
+}
+
+/// The staged copy of `package`, if it is complete and intact. Its marker is removed: a copy is used once.
+pub fn take_staged(locator: &VelopackLocator, package: &Path, version: &str, bundle: &BundleZip) -> Option<PathBuf> {
+    let sw = Instant::now();
+    let root = stage_root(locator);
+    let dir = final_dir(&root, version);
+    let marker = marker_file(&root, version);
+    if !dir.is_dir() || !marker.is_file() {
+        info!("No staged copy of {} (looked in {:?})", version, dir);
+        return None;
+    }
+    let identity = package_identity(package).ok()?;
+    let found = fs::read_to_string(&marker).unwrap_or_default();
+    if found.trim() != identity {
+        warn!("Staged copy of {} is for {:?}, not {:?}; not using it", version, found.trim(), identity);
+        return None;
+    }
+    let expected = match expected_files(bundle) {
+        Ok(e) => e,
+        Err(e) => {
+            warn!("Could not list package files ({}); not using the staged copy", e);
+            return None;
+        }
+    };
+    if let Err(e) = verify_tree(&dir, &expected) {
+        warn!("Staged copy of {} is incomplete ({}); extracting instead", version, e);
+        let _ = fs::remove_file(&marker);
+        return None;
+    }
+    let _ = fs::remove_file(&marker);
+    info!("Using staged copy {:?} ({} files verified in {} ms)", dir, expected.len(), sw.elapsed().as_millis());
+    Some(dir)
+}
+
+/// Asks apply to start the app as soon as `current` holds the new version.
+pub fn request_early_start(exe_args: Option<Vec<OsString>>) {
+    if let Ok(mut g) = EARLY_START.lock() {
+        *g = Some(exe_args);
+    }
+}
+
+pub fn already_started() -> bool {
+    STARTED_PID.lock().map(|g| g.is_some()).unwrap_or(false)
+}
+
+/// Starts the app (with the restart marker), then closes the overlay once it shows a window.
+pub fn start_tracked(locator: &VelopackLocator, exe_args: Option<Vec<OsString>>) -> Result<u32> {
+    let current = locator.get_current_bin_dir();
+    let exe = locator.get_main_exe_path();
+    if !exe.exists() {
+        bail!("Unable to find executable to start: '{:?}'", exe);
+    }
+    let mut env = HashMap::new();
+    env.insert(constants::HOOK_ENV_RESTART.to_string(), "true".to_string());
+    let sw = Instant::now();
+    let handle = process::run_process(&exe, exe_args.unwrap_or_default(), Some(&current), true, Some(env))?;
+    let pid = handle.pid();
+    info!("Started {:?} (pid {}, CreateProcess {} ms)", exe, pid, sw.elapsed().as_millis());
+    if let Ok(mut g) = STARTED_PID.lock() {
+        *g = Some(pid);
+    }
+    sei_overlay::set_phase(Phase::Started);
+    sei_overlay::close_when_window_visible(pid, Duration::from_secs(20));
+    Ok(pid)
+}
+
+/// Called by apply right after `current` was replaced.
+pub fn on_swapped(new_locator: &VelopackLocator) {
+    let args = EARLY_START.lock().ok().and_then(|mut g| g.take());
+    if let Some(args) = args {
+        match start_tracked(new_locator, args) {
+            Ok(_) => set_background_priority(),
+            Err(e) => warn!("Early start failed ({}); apply will start the app at the end", e),
+        }
+    }
+}
+
+/// Removes `applying.pid` when dropped.
+pub struct ApplyingMarker(PathBuf);
+
+impl Drop for ApplyingMarker {
+    fn drop(&mut self) {
+        let _ = fs::remove_file(&self.0);
+    }
+}
+
+pub fn mark_applying(locator: &VelopackLocator) -> Option<ApplyingMarker> {
+    let root = stage_root(locator);
+    fs::create_dir_all(&root).ok()?;
+    let path = root.join("applying.pid");
+    fs::write(&path, format!("{}", std::process::id())).ok()?;
+    Some(ApplyingMarker(path))
+}
+
+/// After apply: start the app if Sei was launched during a no-restart apply (it leaves `relaunch` and exits), and
+/// drop staged leftovers of other versions.
+pub fn after_apply(locator: &VelopackLocator, restarted: bool) {
+    let root = stage_root(locator);
+    let relaunch = root.join("relaunch");
+    // a launch that saw applying.pid a moment before we finished may still be writing its request
+    std::thread::sleep(Duration::from_millis(250));
+    if relaunch.exists() {
+        let _ = fs::remove_file(&relaunch);
+        if !restarted && !already_started() {
+            info!("Sei was launched during the apply, starting it now");
+            if let Err(e) = start_tracked(locator, None) {
+                warn!("Could not start Sei after the apply: {}", e);
+            }
+        }
+    }
+    // a stage started by the restarted app (an even newer version) holds the lock; leave its work alone
+    match LockFile::try_acquire_lock(root.join(".lock")) {
+        Ok(_lock) => clean_root(&root, None),
+        Err(_) => info!("A stage is running, not cleaning {:?}", root),
+    }
+}
